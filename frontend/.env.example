# Copy this file to .env and adjust for your environment.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase (Project Settings -> API Keys). The publishable key is designed to
# ship in the browser; never put the secret key here. Leave both empty to run
# in anonymous mode (predictor works, nothing is saved).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
